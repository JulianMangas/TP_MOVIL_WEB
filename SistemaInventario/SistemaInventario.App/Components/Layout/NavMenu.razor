@implements IDisposable
@inject AuthService Auth
@inject CarritoService Carro
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Sistema de Inventario</a>
    </div>
</div>

<input type="checkbox" title="Menú de navegación" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        Catálogo
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="carrito">
                        Carrito
                        @if (Carro.CantidadTotal > 0)
                        {
                            <span class="badge bg-primary ms-1">@Carro.CantidadTotal</span>
                        }
                    </NavLink>
                </div>
                <AuthorizeView Roles="Administrador" Context="esAdmin">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="ingresos">
                            Ingreso de mercadería
                        </NavLink>
                    </div>
                </AuthorizeView>
                <div class="nav-item px-3 pt-3 small text-white-50">
                    @Auth.Nombre (@Auth.Rol)
                </div>

                <div class="nav-item px-3">
                    <a class="nav-link" href="" @onclick="Salir" @onclick:preventDefault>
                        Cerrar sesión
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        Carro.Cambio += Actualizar;
    }

    private void Actualizar()
    {
        InvokeAsync(StateHasChanged);
    }

    private void Salir()
    {
        Auth.Logout();
        Nav.NavigateTo("login");
    }

    public void Dispose()
    {
        Carro.Cambio -= Actualizar;
    }
}