@page "/carrito"
@attribute [Authorize]
@using System.Globalization
@inject CarritoService Carro
@inject CatalogoService Servicio

<h3 class="mb-3">Carrito</h3>

@if (Carro.Items.Count == 0)
{
    <p class="text-muted">Tu carrito está vacío.</p>
    <a href="" class="btn btn-primary">Ir al catálogo</a>
}
else
{
    @foreach (var item in Carro.Items)
    {
        var urlImagen = Servicio.UrlImagen(item.ImagenUrl);

        <div class="card mb-2">
            <div class="card-body d-flex gap-3 align-items-center">
                @if (urlImagen != null)
                {
                    <img src="@urlImagen" alt="@item.Nombre"
                         style="width:64px; height:64px; object-fit:cover;" />
                }
                else
                {
                    <div class="bg-light text-muted small d-flex align-items-center justify-content-center"
                         style="width:64px; height:64px;">
                        Sin imagen
                    </div>
                }

                <div class="flex-grow-1">
                    <div class="fw-bold">@item.Nombre</div>
                    <small class="text-muted">$ @item.Precio.ToString("N2", es) c/u</small>

                    <div class="d-flex align-items-center gap-2 mt-1">
                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="() => Carro.CambiarCantidad(item.ProductoId, -1)">
                            −
                        </button>
                        <span>@item.Cantidad</span>
                        <button class="btn btn-outline-secondary btn-sm"
                                disabled="@(item.Cantidad >= item.Stock)"
                                @onclick="() => Carro.CambiarCantidad(item.ProductoId, 1)">
                            +
                        </button>
                    </div>
                </div>

                <div class="text-end">
                    <div class="fw-bold">$ @item.Subtotal.ToString("N2", es)</div>
                    <button class="btn btn-link text-danger p-0"
                            @onclick="() => Carro.Quitar(item.ProductoId)">
                        Quitar
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="d-flex justify-content-between fs-5 fw-bold my-3">
        <span>Total</span>
        <span>$ @Carro.Total.ToString("N2", es)</span>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-danger" @onclick="Carro.Vaciar">Vaciar</button>
        <a href="pago" class="btn btn-success flex-grow-1">Ir a pagar</a>
    </div>
}

@code {
    private static readonly CultureInfo es = new("es-AR");
}